{
  "name": "NovaMart Retail DWH Pipeline",
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "format": "MULTI_TASK",
  "queue": {
    "enabled": true
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/Chicago",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": []
  },
  "job_clusters": [
    {
      "job_cluster_key": "retail_dwh_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        },
        "custom_tags": {
          "ResourceClass": "SingleNode",
          "project": "retail_dwh"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "01_setup_and_sample_data",
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/01_setup_and_sample_data",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "02_bronze_ingestion",
      "depends_on": [
        {
          "task_key": "01_setup_and_sample_data"
        }
      ],
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/02_bronze_ingestion",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "03_silver_transform",
      "depends_on": [
        {
          "task_key": "02_bronze_ingestion"
        }
      ],
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/03_silver_transform",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "04_gold_star_schema",
      "depends_on": [
        {
          "task_key": "03_silver_transform"
        }
      ],
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/04_gold_star_schema",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "05_scd2_customers",
      "depends_on": [
        {
          "task_key": "04_gold_star_schema"
        }
      ],
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/05_scd2_customers",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "06_data_quality",
      "depends_on": [
        {
          "task_key": "05_scd2_customers"
        }
      ],
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/06_data_quality",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "07_analytics_sql",
      "depends_on": [
        {
          "task_key": "06_data_quality"
        }
      ],
      "job_cluster_key": "retail_dwh_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/akhilvydyula01/databricks/notebooks/data_warehouse/07_analytics_sql",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    }
  ],
  "tags": {
    "project": "novamart_retail_dwh",
    "course": "databricks_data_warehouse"
  }
}
